---
import BaseHead from '../BaseHead.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { apps } from '../../data/apps';
import { getLangFromUrl } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const appsUrl = currentLang === 'en' ? '/en/apps' : '/apps';

const app = apps.find((entry) => entry.slug === 'verbs')!;

// TODO: ampliar esta landing con capturas y features cuando estén listas.
const description = 'Verbs is a free iOS app available on the App Store.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${app.name} | App`} description={description} />
		<style>
			.hero {
				display: flex;
				align-items: center;
				gap: 1.5rem;
				margin-bottom: 2rem;
			}
			.hero .icon {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 88px;
				height: 88px;
				border-radius: 20px;
				font-size: 2.5rem;
				font-weight: 700;
				color: var(--background);
				background: linear-gradient(135deg, rgba(var(--gray), 85%), var(--accent));
				flex-shrink: 0;
			}
			.hero h1 {
				margin: 0 0 0.25rem;
			}
			.hero p {
				margin: 0;
				color: rgb(var(--gray));
			}
			.store-link {
				display: inline-block;
				padding: 0.7rem 1.4rem;
				border-radius: 10px;
				background-color: var(--accent);
				color: var(--background);
				text-decoration: none;
				font-weight: 700;
			}
			.store-link:hover {
				opacity: 0.9;
			}
			.support h2 {
				font-size: 1.1rem;
				margin-bottom: 0.5rem;
			}
			.support ul {
				margin: 0;
				padding-left: 1.2rem;
			}
			.back {
				display: inline-block;
				margin-bottom: 1.5rem;
				color: rgb(var(--gray));
			}
			@media (max-width: 520px) {
				.hero {
					flex-direction: column;
					align-items: flex-start;
					gap: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a class="back" href={appsUrl}>&larr; Apps</a>

			<section class="hero">
				<span class="icon" aria-hidden="true">{app.name.charAt(0)}</span>
				<div>
					<h1>{app.name}</h1>
					<p>{app.tagline.en}</p>
				</div>
			</section>

			<section>
				<p>{description}</p>
				{
					app.links?.appStore && (
						<p>
							<a class="store-link" href={app.links.appStore} target="_blank" rel="noopener noreferrer">
								Download on the App Store
							</a>
						</p>
					)
				}
			</section>

			<section class="support">
				<h2>Privacy</h2>
				<ul>
					<li><a href="/verbs/verbsPrivacyPolice">Privacy Policy (iOS)</a></li>
					<li><a href="/verbs/verbs3PrivacyPolice">Privacy Policy (Verbs3, Android)</a></li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
