---
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";

export interface Props {
  readonly id?: string;
  readonly className?: string;
  readonly query?: string;
}

const { id, className, query } = Astro.props;
---

<PagefindConfig />
<pagefind-searchbox
  id={id}
  class:list={[className]}
  data-query={query}
  autofocus
  hide-shortcut
  show-sub-results
></pagefind-searchbox>

<script>
  type SearchboxElement = HTMLElement & { inputEl: HTMLInputElement | null };

  function initSearch(el: SearchboxElement) {
    const input = el.inputEl;
    if (!input) return;

    const url = new URL(window.location.href);
    const params = new URLSearchParams(url.search);
    const initialQuery = params.get("q") ?? el.dataset.query ?? "";

    if (initialQuery) {
      input.value = initialQuery;
      input.dispatchEvent(new Event("input", { bubbles: true }));
    }

    input.addEventListener("input", (e) => {
      const value = (e.target as HTMLInputElement).value;
      const url = new URL(window.location.href);
      const params = new URLSearchParams(url.search);
      if (value) {
        params.set("q", value);
      } else {
        params.delete("q");
      }
      window.history.replaceState({}, "", `${url.pathname}?${params}`);
    });
  }

  function setup() {
    document
      .querySelectorAll<SearchboxElement>("pagefind-searchbox")
      .forEach(initSearch);
  }

  customElements.whenDefined("pagefind-searchbox").then(setup);
  document.addEventListener("astro:page-load", () => {
    customElements.whenDefined("pagefind-searchbox").then(setup);
  });
</script>
