---
import { apps } from '../data/apps';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// Las landings viven bajo el prefijo del idioma actual.
const localizedPath = (path: string) => (currentLang === 'en' ? `/en${path}` : path);
---

{
	apps.length === 0 ? (
		<p class="empty">{t('apps.empty')}</p>
	) : (
		<ul class="apps-grid">
			{apps.map((app) => (
				<li>
					<a href={localizedPath(app.path)}>
						{app.icon ? (
							<img class="icon" src={app.icon} alt={app.name} width="72" height="72" />
						) : (
							<span class="icon icon-placeholder" aria-hidden="true">
								{app.name.charAt(0)}
							</span>
						)}
						<h2 class="name">{app.name}</h2>
						<p class="tagline">{app.tagline[currentLang]}</p>
						<ul class="platforms">
							{app.platforms.map((platform) => (
								<li>{platform}</li>
							))}
						</ul>
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.apps-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.apps-grid > li {
		display: flex;
	}
	.apps-grid > li > a {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		width: 100%;
		padding: 1.5rem;
		border: 1px solid rgba(var(--gray), 25%);
		border-radius: 12px;
		background-color: var(--background);
		text-decoration: none;
		color: rgb(var(--gray-dark));
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}
	.apps-grid > li > a:hover,
	.apps-grid > li > a:focus-visible {
		transform: translateY(-2px);
		border-color: var(--accent);
		box-shadow: var(--box-shadow);
	}
	.icon {
		width: 72px;
		height: 72px;
		border-radius: 16px;
		object-fit: cover;
	}
	.icon-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 2rem;
		font-weight: 700;
		color: var(--background);
		background: linear-gradient(135deg, rgba(var(--gray), 85%), var(--accent));
	}
	.name {
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.2;
	}
	.tagline {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.95rem;
		flex-grow: 1;
	}
	.platforms {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.platforms li {
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		background-color: rgba(var(--gray), 15%);
		color: rgb(var(--gray-dark));
		font-size: 0.75rem;
	}
	.apps-grid > li > a:hover .name {
		color: var(--accent);
	}
	.empty {
		color: rgb(var(--gray));
	}
	@media (max-width: 520px) {
		.apps-grid {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
		.apps-grid > li > a {
			padding: 1.25rem;
		}
	}
</style>
