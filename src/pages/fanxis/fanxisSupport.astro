---
import BaseHead from '../../components/BaseHead.astro';

const CONTACT_EMAIL = 'erikfloresq@icloud.com';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Support - Fanxis" description="Help and contact for the Fanxis iOS application" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
		<style is:global>
			:root {
				--bg-color: #0B0A0F;
				--card-bg: rgba(20, 18, 28, 0.7);
				--card-border: rgba(255, 255, 255, 0.05);
				--primary: #5856D6;
				--primary-light: #8E8CF0;
				--text-primary: #FFFFFF;
				--text-secondary: #9CA3AF;
				--accent: #0A84FF;
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			/* The decorative glow orbs sit partly off-screen; without this the page can be
			   dragged sideways on phones. body's overflow-x alone does not contain them. */
			html {
				overflow-x: clip;
			}

			body {
				font-family: 'Inter', sans-serif;
				background-color: var(--bg-color);
				color: var(--text-primary);
				line-height: 1.6;
				overflow-x: hidden;
				position: relative;
			}

			/* Ambient glows background */
			.glow-orb-1 {
				position: absolute;
				width: 400px;
				height: 400px;
				border-radius: 50%;
				background: radial-gradient(circle, rgba(88, 86, 214, 0.15) 0%, rgba(0, 0, 0, 0) 70%);
				top: -100px;
				left: -100px;
				z-index: -1;
			}

			.glow-orb-2 {
				position: absolute;
				width: 500px;
				height: 500px;
				border-radius: 50%;
				background: radial-gradient(circle, rgba(10, 132, 255, 0.08) 0%, rgba(0, 0, 0, 0) 70%);
				bottom: 200px;
				right: -100px;
				z-index: -1;
			}

			.container {
				max-width: 900px;
				margin: 0 auto;
				padding: 40px 20px;
			}

			/* Header UI */
			header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding-bottom: 30px;
				border-bottom: 1px solid var(--card-border);
				margin-bottom: 40px;
			}

			.logo {
				display: flex;
				align-items: center;
				gap: 12px;
			}

			.logo-icon {
				width: 40px;
				height: 40px;
				border-radius: 10px;
				background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 100%);
				display: flex;
				align-items: center;
				justify-content: center;
				box-shadow: 0 4px 14px rgba(88, 86, 214, 0.4);
				font-weight: 800;
				font-size: 20px;
				color: #fff;
			}

			.logo-text {
				font-size: 22px;
				font-weight: 800;
				letter-spacing: -0.5px;
				background: linear-gradient(135deg, #FFFFFF 0%, #D1D5DB 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}

			.language-badge {
				background-color: rgba(88, 86, 214, 0.1);
				border: 1px solid rgba(88, 86, 214, 0.2);
				color: var(--primary-light);
				padding: 6px 14px;
				border-radius: 20px;
				font-size: 12px;
				font-weight: 600;
				letter-spacing: 0.5px;
				text-transform: uppercase;
			}

			/* Hero Banner */
			.hero {
				text-align: center;
				margin-bottom: 50px;
			}

			.hero h1 {
				font-size: 42px;
				font-weight: 800;
				letter-spacing: -1px;
				margin-bottom: 12px;
				background: linear-gradient(135deg, #FFFFFF 0%, #8E8CF0 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}

			.hero p {
				color: var(--text-secondary);
				font-size: 16px;
				font-weight: 500;
			}

			/* Glassmorphic Policy Content Card */
			.policy-card {
				background: var(--card-bg);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border: 1px solid var(--card-border);
				border-radius: 24px;
				padding: 40px;
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
				margin-bottom: 40px;
			}

			/* Language Toggle Tabs */
			.tabs {
				display: flex;
				gap: 8px;
				background: rgba(255, 255, 255, 0.03);
				padding: 4px;
				border-radius: 12px;
				border: 1px solid var(--card-border);
				margin-bottom: 30px;
				width: fit-content;
			}

			.tab-btn {
				background: none;
				border: none;
				color: var(--text-secondary);
				padding: 8px 20px;
				font-size: 14px;
				font-weight: 600;
				border-radius: 8px;
				cursor: pointer;
				transition: all 0.3s ease;
			}

			.tab-btn.active {
				background-color: var(--primary);
				color: var(--text-primary);
				box-shadow: 0 4px 12px rgba(88, 86, 214, 0.3);
			}

			/* Content Sections Styling */
			.content-section {
				display: none;
			}

			.content-section.active {
				display: block;
				animation: fadeIn 0.5s ease;
			}

			@keyframes fadeIn {
				from { opacity: 0; transform: translateY(10px); }
				to { opacity: 1; transform: translateY(0); }
			}

			h2 {
				font-size: 20px;
				font-weight: 700;
				color: var(--text-primary);
				margin-top: 30px;
				margin-bottom: 12px;
				border-left: 3px solid var(--primary);
				padding-left: 12px;
				letter-spacing: -0.3px;
			}

			h2:first-of-type {
				margin-top: 0;
			}

			p {
				color: var(--text-secondary);
				font-size: 15px;
				margin-bottom: 18px;
				font-weight: 400;
			}

			ul {
				list-style: none;
				margin-bottom: 20px;
				padding-left: 4px;
			}

			li {
				color: var(--text-secondary);
				font-size: 15px;
				margin-bottom: 10px;
				position: relative;
				padding-left: 20px;
			}

			li::before {
				content: "•";
				color: var(--primary);
				font-weight: bold;
				font-size: 18px;
				position: absolute;
				left: 0;
				top: -2px;
			}

			a {
				color: var(--primary-light);
				text-decoration: underline;
				text-underline-offset: 2px;
			}

			a:hover {
				color: var(--text-primary);
			}

			strong {
				color: var(--text-primary);
				font-weight: 600;
			}

			/* Alert Callout */
			.offline-callout {
				background: rgba(88, 86, 214, 0.05);
				border: 1px dashed rgba(88, 86, 214, 0.3);
				border-radius: 12px;
				padding: 20px;
				margin-bottom: 30px;
				display: flex;
				gap: 16px;
				align-items: flex-start;
			}

			.offline-callout-icon {
				font-size: 24px;
				line-height: 1;
			}

			.offline-callout-text h3 {
				font-size: 16px;
				font-weight: 700;
				margin-bottom: 4px;
				color: var(--primary-light);
			}

			.offline-callout-text p {
				margin-bottom: 0;
				font-size: 14px;
			}

			/* Footer */
			footer {
				text-align: center;
				color: var(--text-secondary);
				font-size: 13px;
				border-top: 1px solid var(--card-border);
				padding-top: 30px;
				margin-top: 50px;
			}

			footer a {
				color: var(--primary-light);
				text-decoration: none;
				font-weight: 500;
				transition: color 0.2s ease;
			}

			footer a:hover {
				color: var(--text-primary);
			}

			@media (max-width: 600px) {
				.policy-card {
					padding: 24px;
				}
				.hero h1 {
					font-size: 32px;
				}
			}

			/* Numbered steps */
			ol {
				margin-bottom: 20px;
				padding-left: 22px;
			}

			ol li {
				padding-left: 6px;
			}

			ol li::before {
				content: none;
			}

			ol li::marker {
				color: var(--primary-light);
				font-weight: 700;
			}

			h3.question {
				font-size: 17px;
				font-weight: 700;
				color: var(--text-primary);
				margin-top: 26px;
				margin-bottom: 10px;
				letter-spacing: -0.2px;
			}
		</style>
	</head>
	<body>
		<div class="glow-orb-1"></div>
		<div class="glow-orb-2"></div>

		<div class="container">
			<!-- Top Bar -->
			<header>
				<div class="logo">
					<div class="logo-icon">F</div>
					<div class="logo-text">Fanxis</div>
				</div>
				<div class="language-badge">Support</div>
			</header>

			<!-- Main Hero -->
			<div class="hero">
				<h1>Support</h1>
				<p>Help with Fanxis · Ayuda con Fanxis</p>
			</div>

			<div class="policy-card">
				<!-- Language toggle tabs -->
				<div class="tabs">
					<button class="tab-btn active" data-lang="en">English</button>
					<button class="tab-btn" data-lang="es">Español</button>
				</div>

				<!-- ENGLISH SECTION -->
				<div id="support-en" class="content-section active">
					<div class="offline-callout">
						<div class="offline-callout-icon">💬</div>
						<div class="offline-callout-text">
							<h3>Need a hand?</h3>
							<p>Most questions are answered below. If yours is not, email <a href={`mailto:${CONTACT_EMAIL}`}><strong>{CONTACT_EMAIL}</strong></a>.</p>
						</div>
					</div>

					<h2>Common questions</h2>

					<h3 class="question">I see "The … language has not been downloaded"</h3>
					<p>Fanxis uses Apple's speech models, which are downloaded once for each language.</p>
					<ol>
						<li>Tap the <strong>…</strong> button at the top right, then <strong>Settings</strong>.</li>
						<li>Tap <strong>Transcription Language</strong>.</li>
						<li>Find your language and tap the download icon next to it. Wait for the download to finish.</li>
						<li>Tap the language to select it. A checkmark appears.</li>
						<li>Go back and tap the microphone.</li>
					</ol>

					<h3 class="question">Nothing appears when I speak</h3>
					<p>Fanxis needs access to the microphone and to speech recognition.</p>
					<ol>
						<li>Open the iOS <strong>Settings</strong> app.</li>
						<li>Scroll down and tap <strong>Fanxis</strong>.</li>
						<li>Turn on <strong>Microphone</strong> and <strong>Speech Recognition</strong>.</li>
					</ol>
					<p>Also check that the transcription language matches the language you are speaking, and that you have downloaded it.</p>

					<h3 class="question">How do I turn the text around for the person across from me?</h3>
					<p>Place two fingers on the text and <strong>swipe up</strong>. The transcript rotates so it reads the right way up from the other side of the device. <strong>Swipe down</strong> with two fingers to turn it back. A one-finger swipe scrolls the text as usual.</p>

					<h3 class="question">Can I start recording with Siri?</h3>
					<p>Yes. Say <strong>"Start recording with Fanxis"</strong>. Fanxis opens and starts listening straight away. You can also find Fanxis in the Shortcuts app, and on iPhone models with an Action button you can assign it there.</p>

					<h3 class="question">Recording stopped when I switched to another app</h3>
					<p>Fanxis can only listen while it is open on screen. Keep it in the foreground while you are transcribing.</p>

					<h3 class="question">Are my transcripts saved?</h3>
					<p>No. Fanxis does not save transcripts. The text is discarded when you clear it, start a new recording, or close the app. To keep a transcript, <strong>touch and hold</strong> the text and tap <strong>Copy</strong> before clearing it.</p>

					<h3 class="question">How do I clear the text?</h3>
					<p>Tap the <strong>…</strong> button at the top right, then <strong>Clean</strong>.</p>

					<h3 class="question">How do I make the text bigger?</h3>
					<p>Tap the <strong>…</strong> button, then <strong>Settings</strong> → <strong>Font Size</strong>, and use the stepper to adjust the size.</p>

					<h3 class="question">Which languages are supported?</h3>
					<p>Open <strong>Settings</strong> → <strong>Transcription Language</strong> to see every language available on your device. The list is provided by iOS and can vary between iOS versions.</p>

					<h3 class="question">What do I need to use Fanxis?</h3>
					<p>An iPhone or iPad running iOS 26 or later.</p>

					<h2>Contact</h2>
					<p>Email <a href={`mailto:${CONTACT_EMAIL}`}><strong>{CONTACT_EMAIL}</strong></a>. To help us solve the problem quickly, please include:</p>
					<ul>
						<li>your device model (for example, iPhone 17 or iPad Pro);</li>
						<li>your iOS version;</li>
						<li>the transcription language you selected;</li>
						<li>what you did and what happened.</li>
					</ul>
				</div>

				<!-- SPANISH SECTION -->
				<div id="support-es" class="content-section">
					<div class="offline-callout">
						<div class="offline-callout-icon">💬</div>
						<div class="offline-callout-text">
							<h3>¿Necesitas ayuda?</h3>
							<p>La mayoría de las dudas se responden abajo. Si no encuentras la tuya, escribe a <a href={`mailto:${CONTACT_EMAIL}`}><strong>{CONTACT_EMAIL}</strong></a>.</p>
						</div>
					</div>

					<h2>Preguntas frecuentes</h2>

					<h3 class="question">Veo "El idioma … no se ha descargado"</h3>
					<p>Fanxis usa los modelos de voz de Apple, que se descargan una sola vez por idioma.</p>
					<ol>
						<li>Toca el botón <strong>…</strong> arriba a la derecha y luego <strong>Ajustes</strong>.</li>
						<li>Toca <strong>Idioma de transcripción</strong>.</li>
						<li>Busca tu idioma y toca el ícono de descarga que está a su lado. Espera a que termine.</li>
						<li>Toca el idioma para seleccionarlo. Aparece una marca de verificación.</li>
						<li>Regresa y toca el micrófono.</li>
					</ol>

					<h3 class="question">No aparece nada cuando hablo</h3>
					<p>Fanxis necesita acceso al micrófono y al reconocimiento de voz.</p>
					<ol>
						<li>Abre la app <strong>Ajustes</strong> de iOS.</li>
						<li>Desplázate hacia abajo y toca <strong>Fanxis</strong>.</li>
						<li>Activa <strong>Micrófono</strong> y <strong>Reconocimiento de voz</strong>.</li>
					</ol>
					<p>Revisa también que el idioma de transcripción sea el que estás hablando y que ya lo hayas descargado.</p>

					<h3 class="question">¿Cómo volteo el texto para la persona que está frente a mí?</h3>
					<p>Pon dos dedos sobre el texto y <strong>desliza hacia arriba</strong>. La transcripción gira para que se lea al derecho desde el otro lado del dispositivo. <strong>Desliza hacia abajo</strong> con dos dedos para regresarla. Deslizar con un solo dedo desplaza el texto como siempre.</p>

					<h3 class="question">¿Puedo empezar a grabar con Siri?</h3>
					<p>Sí, con Siri en inglés: di <strong>"Start recording with Fanxis"</strong> y Fanxis se abre escuchando de inmediato. Si usas Siri en otro idioma, busca Fanxis en la app <strong>Atajos</strong>; en los modelos de iPhone con botón de Acción también puedes asignarlo ahí.</p>

					<h3 class="question">La grabación se detuvo cuando cambié de app</h3>
					<p>Fanxis solo puede escuchar mientras está abierta en pantalla. Mantenla en primer plano mientras transcribes.</p>

					<h3 class="question">¿Se guardan mis transcripciones?</h3>
					<p>No. Fanxis no guarda transcripciones. El texto se descarta cuando lo borras, cuando inicias una nueva grabación o cuando cierras la app. Para conservar una transcripción, <strong>mantén presionado</strong> el texto y toca <strong>Copiar</strong> antes de borrarlo.</p>

					<h3 class="question">¿Cómo borro el texto?</h3>
					<p>Toca el botón <strong>…</strong> arriba a la derecha y luego <strong>Limpiar</strong>.</p>

					<h3 class="question">¿Cómo hago el texto más grande?</h3>
					<p>Toca el botón <strong>…</strong>, luego <strong>Ajustes</strong> → <strong>Tamaño de letra</strong>, y ajusta el tamaño con los botones.</p>

					<h3 class="question">¿Qué idiomas están disponibles?</h3>
					<p>Abre <strong>Ajustes</strong> → <strong>Idioma de transcripción</strong> para ver todos los idiomas disponibles en tu dispositivo. La lista la proporciona iOS y puede variar entre versiones.</p>

					<h3 class="question">¿Qué necesito para usar Fanxis?</h3>
					<p>Un iPhone o iPad con iOS 26 o posterior.</p>

					<h2>Contacto</h2>
					<p>Escribe a <a href={`mailto:${CONTACT_EMAIL}`}><strong>{CONTACT_EMAIL}</strong></a>. Para ayudarte más rápido, incluye:</p>
					<ul>
						<li>el modelo de tu dispositivo (por ejemplo, iPhone 17 o iPad Pro);</li>
						<li>tu versión de iOS;</li>
						<li>el idioma de transcripción que elegiste;</li>
						<li>qué hiciste y qué pasó.</li>
					</ul>
				</div>
			</div>

			<!-- Footer -->
			<footer>
				<p><a href="/fanxis/fanxisPrivacyPolicy">Privacy Policy · Política de privacidad</a></p>
				<p>&copy; 2026 Fanxis. All rights reserved.</p>
			</footer>
		</div>

		<script>
			// Language switching, same behaviour as the privacy policy page.
			const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');

			tabButtons.forEach(button => {
				button.addEventListener('click', (event) => {
					const lang = button.getAttribute('data-lang');
					const currentTarget = event.currentTarget as HTMLButtonElement | null;
					if (lang && currentTarget) {
						switchLanguage(lang, currentTarget);
					}
				});
			});

			function switchLanguage(lang: string, targetButton: HTMLButtonElement) {
				tabButtons.forEach(btn => btn.classList.remove('active'));
				targetButton.classList.add('active');

				document.querySelectorAll('.content-section').forEach(sec => sec.classList.remove('active'));

				const targetSection = document.getElementById(`support-${lang}`);
				if (targetSection) {
					targetSection.classList.add('active');
				}
			}
		</script>
	</body>
</html>
